DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Production PostgreSQL is self-hosted on the WEB VPS. Do not use a Neon pooler here.

# Steam OpenID login. STEAM_RETURN_URL should point to this callback on your deployed site:
# https://YOUR-DOMAIN/api/auth/steam/callback
STEAM_RETURN_URL="https://duelplaygame.com/api/auth/steam/callback"
# Optional: used only to import the user's Steam persona name/avatar.
STEAM_API_KEY=""

# Existing DuelPlay admin bootstrap
DUELPLAY_ADMIN_EMAIL=""
DUELPLAY_ADMIN_PASSWORD=""

# Optional legacy single-server URL. The new server manager writes per-match URLs instead.
CS2_SERVER_CONNECT_URL=""

# DuelPlay CS2 server-manager authentication. Use long random secrets.
DUELPLAY_SERVER_MANAGER_SECRET=""
CS2_RESULT_SECRET=""

# Public URL of the DuelPlay deployment, used by the VPS manager.
DUELPLAY_API_URL="https://duelplaygame.com"

# Owner wallet that receives administrative deductions.
# Set this to the owner's SteamID64 (17 digits).
DUELPLAY_OWNER_STEAM_ID=""

# Test accounts (keep this secret; used only on /test-login)
DUELPLAY_TEST_ACCOUNTS_SECRET=""

# 64 hex chars = 32-byte AES-256 key used to encrypt admin TOTP secrets at rest.
DUELPLAY_MFA_ENCRYPTION_KEY=""

# Local-only simulated CS2 server flow for test accounts
DUELPLAY_LOCAL_TEST_MODE=false

# MASTER CHECKLIST
DUELPLAY_JOB_SECRET=""
NEXT_PUBLIC_APP_URL=http://localhost:3000
DUELPLAY_SERVER_ID=cs2-1

# Public social and support links. These override the defaults in lib/config/site.ts.
NEXT_PUBLIC_SITE_URL="https://duelplaygame.com/"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/KBk8pQNhKj"
NEXT_PUBLIC_STEAM_GROUP_URL="https://steamcommunity.com/groups/duelplay/"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/DuelPlayGame"
# Monitored support mailbox (Cloudflare Email Routing -> Gmail, incoming only).
NEXT_PUBLIC_SUPPORT_EMAIL="support@duelplaygame.com"
# Optional custom support destination. Falls back to the Discord invite.
NEXT_PUBLIC_SUPPORT_URL=""
CS2_PUBLIC_HOST=127.0.0.1
CS2_PORT=27015
CS2_START_TIMEOUT_MS=120000
CS2_CONNECT_TIMEOUT_MS=300000

# Match timer authority (milliseconds)
DUELPLAY_START_TIMEOUT_MS=120000
DUELPLAY_CONNECTION_TIMEOUT_MS=300000
DUELPLAY_HEARTBEAT_TIMEOUT_MS=60000
DUELPLAY_LIVE_TIMEOUT_MS=300000
DUELPLAY_SERVER_START_TIMEOUT_MS=120000

# Steam Trade provider (HTTP adapter + signed callbacks)
STEAM_TRADE_ENABLED=false
STEAM_TRADE_PROVIDER=none
STEAM_TRADE_PROVIDER_URL=""
STEAM_TRADE_PROVIDER_SECRET=""
STEAM_TRADE_WEBHOOK_SECRET=""

# Payment gateway contract. Keep production disabled until a concrete adapter is implemented and approved.
DUELPLAY_PAYMENT_PROVIDER=""
DUELPLAY_PAYMENT_WEBHOOK_SECRET=""


# Cloudflare R2 PostgreSQL backup target (S3-compatible API).
R2_ENDPOINT=""
R2_BUCKET=""
R2_BACKUP_PREFIX="postgres"
R2_BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Persistent random secret (at least 32 bytes); keep identical across deployments. Required to delete accounts with a recoverable REAL balance.
DUELPLAY_ACCOUNT_RECOVERY_HMAC_SECRET=""
