# Public URL of the deployed DuelPlay app, without a trailing slash.
DUELPLAY_API_URL=https://YOUR-DUELPLAY-DOMAIN

# Same secret must be configured on the DuelPlay app and this VPS. Keep private.
DUELPLAY_SERVER_MANAGER_SECRET=CHANGE_ME_LONG_RANDOM_MANAGER_SECRET
CS2_RESULT_SECRET=CHANGE_ME_LONG_RANDOM_RESULT_SECRET
CS2_GSI_TOKEN=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET

# Current VPS layout
CS2_DIR=/home/ubuntu/cs2/instances/cs2-1/root
# Keep the dedicated server on the same current build as Steam clients.
CS2_AUTO_UPDATE=false
STEAMCMD_BIN=/usr/games/steamcmd
CS2_APP_ID=730
CS2_PUBLIC_HOST=YOUR_SERVER_IP
CS2_PORT=27015
DUELPLAY_SERVER_ID=cs2-1
DUELPLAY_MANAGER_PORT=3010
CS2_READY_DELAY_MS=20000
