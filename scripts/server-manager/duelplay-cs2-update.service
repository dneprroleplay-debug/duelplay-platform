[Unit]
Description=Execute one authorized DuelPlay CS2 update run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/duelplay-app
EnvironmentFile=/home/ubuntu/duelplay-app/scripts/server-manager/.env
EnvironmentFile=-/run/duelplay-cs2-update-scheduler/run.env
ExecStart=/usr/bin/flock --nonblock /home/ubuntu/cs2/.duelplay-cs2-update.lock /usr/local/bin/node /home/ubuntu/duelplay-app/scripts/server-manager/update-all.mjs --scheduled
TimeoutStartSec=90min
StandardOutput=journal
StandardError=journal
